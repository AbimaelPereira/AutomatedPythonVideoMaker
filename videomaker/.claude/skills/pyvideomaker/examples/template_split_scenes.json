      "subtitle": {
        "enabled": true,
        "type": "karaoke",
        "uppercase": true,
        "min_chars_per_line": 6,
        "line_fill_ratio": 0.85,
        "lines_per_group": 6,
        "line_gap_ratio": 0.45,
        "placement": { "anchor": ["7%", "center"], "region": "36%" },
        "palette": [
          { "font_path": "./assets/fonts/Montserrat/Montserrat-Light.ttf", "fill": "#FFF6EC" },
          { "font_path": "./assets/fonts/Montserrat/Montserrat-Black.ttf", "fill": "#FFF6EC" }
