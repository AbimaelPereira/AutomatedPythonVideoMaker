            "visible": { "from": { "sentence": 2 }, "to": "end" },
            "actions": [
              { "name": "sobe", "at": { "sentence": 2 }, "duration": 0.6,
                "preset": "rise" },
              { "at": { "word": "bilhão" }, "duration": 0.3, "preset": "punch" },
              { "at": { "after": "sobe", "offset": 0.1 }, "preset": "ken_burns_in" }
            ]
          }
        }
      ],
