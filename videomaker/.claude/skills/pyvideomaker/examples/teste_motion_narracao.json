      "id": "cena_01",
      "narration": {
        "text": "Hoje o dinheiro muda de mão. Porém o lucro de um bilhão não aparece sozinho."
      },
      "background": { "visual": { "type": "color", "source": "#0b1a2b" } },
      "visual_elements": [
        {
          "type": "image",
          "source": "./assets/image/nota.png",
          "placement": { "anchor": ["center", "30%"], "width": "55%" },
          "motion": [
            { "name": "entra", "at": { "word": "dinheiro", "offset": -0.12 },
