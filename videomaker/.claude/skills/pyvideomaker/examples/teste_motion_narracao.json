            { "at": { "word": "mão", "align": "end" }, "duration": 0.4,
              "preset": "slide_out_up" }
          ]
        },
        {
          "type": "image",
          "source": "./assets/image/grafico.png",
          "placement": { "anchor": ["center", "62%"], "width": "70%" },
