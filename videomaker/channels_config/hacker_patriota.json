{
    "global_settings": {
        "tts/": {
            "provider": "local_file",
            "audio_file": "./temp/geo.wav"
        },
        "tts": {
            "provider": "edge",
            "voice": "pt-BR-AntonioNeural",
            "pitch": "-40Hz",
            "rate": "+20%"
        },
        "subtitle": {
            "enabled": true,
            "font_path": "./assets/fonts/Montserrat/Montserrat-Black.ttf",
            "font_size": 110,
            "color": "#1beb0c",
            "uppercase": true,

            "stroke_enabled": true,
            "stroke_color": "#000000",
            "stroke_width": 2,

            "shadow_enabled": true,
            "shadow_color": "#1beb0c",
            "shadow_opacity": 0.6,
            "blur_radius": 10.0,
            "shadow_offset": [
                0,
                0
            ]
        },
        "background": {
            "audio": {
                "type": "directory",
                "source": "./assets/audio/background/suspense",
                "ducking": {
                    "enabled": true,
                    "ducking_db": -10.0
                }
            },
            "visual": {
                "fit_mode": "contain-blur",
                "animation": {
                    "type": "zoom",
                    "duration": 20.0,
                    "intensity": 0.12
                }
            }
        },
        "transitions": {
            "enabled": true,
            "audio": {
                "type": "directory",
                "source": "./assets/audio/effects/transitions",
                "volume": 1.0
            }
        }
    },
    "youtube": {
        "token_file_name": "geopolitica_em_foco.json",
        "privacy_status": "private",
        "category_id": "22"
    }
}