            "placement": { "anchor": ["left", "26%"], "width": "55%", "height": "9%", "relative_to": "screen" },
            "motion": {
              "actions": [
                { "at": 0.4, "duration": 1.6, "ease": "out_quad", "tracks": { "x": ["-100%", 0] } }
              ]
            }
          },
          {
            "type": "color",
            "color": "#7f9bff",
            "placement": { "anchor": ["left", "40%"], "width": "55%", "height": "9%", "relative_to": "screen" },
            "motion": {
              "actions": [
                { "at": 0.4, "duration": 1.6, "ease": "in_out_cubic", "tracks": { "x": ["-100%", 0] } }
