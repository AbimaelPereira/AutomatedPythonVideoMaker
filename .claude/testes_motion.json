            "type": "color",
            "color": "#ffc53d",
            "placement": { "anchor": ["left", "68%"], "width": "55%", "height": "9%", "relative_to": "screen" },
            "motion": {
              "actions": [
                { "at": 0.4, "duration": 1.6, "ease": "out_elastic", "tracks": { "x": ["-100%", 0] } }
              ]
            }
          }
        ]
      },
      {
        "id": "cena_02_keyframes_multiplos",
        "duration": 6.0,
        "_comentario/": "Keyframes em forma longa [t_rel, valor, ease]. Um quadrado sobe, segura, dá um punch de escala e desce. Valida o merge de ações sequenciais com hold entre elas.",
        "visual_elements": [
          {
            "type": "color",
            "color": "#2a56f0",
            "border_radius": 24,
            "placement": { "anchor": ["center", "center"], "width": "22%", "height": "38%", "relative_to": "screen" },
            "motion": {
              "actions": [
                {
                  "name": "sobe",
                  "at": 0.3,
                  "duration": 0.9,
                  "tracks": {
                    "y": [[0, "60%", "out_back"], [1, 0]],
                    "opacity": [0, 1],
                    "scale": [0.85, 1.0]
                  }
                },
                {
                  "name": "punch",
                  "at": { "after": "sobe", "offset": 0.6 },
                  "duration": 0.45,
                  "ease": "out_quad",
                  "tracks": { "scale": [1.0, 1.14, 1.0] }
                },
                {
                  "at": { "after": "punch", "offset": 1.2 },
                  "duration": 0.6,
                  "ease": "in_cubic",
                  "tracks": { "y": [0, "-70%"], "opacity": [1, 0] }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "cena_03_opacidade",
        "duration": 5.0,
        "_comentario/": "Opacidade: o painel da esquerda usa rampa linear (deve virar cadeia de fade, barato); o da direita pisca com easing (deve cair no geq). Compare o tempo de render dos dois no log.",
        "visual_elements": [
          {
            "type": "color",
            "color": "#2a56f0",
            "placement": { "anchor": ["22%", "center"], "width": "30%", "height": "45%", "relative_to": "screen" },
            "motion": {
              "actions": [
                { "at": 0.2, "duration": 1.2, "ease": "linear", "tracks": { "opacity": [0, 1] } },
                { "at": 3.4, "duration": 1.2, "ease": "linear", "tracks": { "opacity": [1, 0] } }
              ]
            }
          },
          {
            "type": "color",
            "color": "#ff5a3c",
            "placement": { "anchor": ["78%", "center"], "width": "30%", "height": "45%", "relative_to": "screen" },
            "motion": {
              "actions": [
                {
                  "at": 0.2,
                  "duration": 4.0,
