                  "tracks": { "opacity": [0.15, 1.0, 0.15, 1.0, 0.15] }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "cena_04_scale_vs_zoom",
        "duration": 5.0,
        "_comentario/": "A diferença que não pode ser unificada: scale transborda a caixa (esquerda, deve invadir o centro da tela); zoom fica dentro da caixa e recorta (direita, a caixa não muda de tamanho). Se os dois ficarem iguais, a implementação está errada.",
        "visual_elements": [
          {
            "type": "color",
            "color": "#2a56f0",
            "border_radius": 16,
            "placement": { "anchor": ["22%", "center"], "width": "26%", "height": "40%", "relative_to": "screen" },
            "motion": {
              "actions": [
                { "at": 0.5, "duration": 3.5, "ease": "in_out_cubic", "tracks": { "scale": [1.0, 1.8] } }
              ]
            }
          },
          {
            "type": "color",
            "color": "#ff5a3c",
            "border_radius": 16,
            "placement": { "anchor": ["78%", "center"], "width": "26%", "height": "40%", "relative_to": "screen" },
            "motion": {
              "actions": [
                { "at": 0.5, "duration": 3.5, "ease": "in_out_cubic", "tracks": { "zoom": [1.0, 1.8] } }
              ]
            }
          }
        ]
      }
    ]
  },

