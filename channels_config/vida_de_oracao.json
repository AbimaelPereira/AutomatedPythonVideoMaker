{
    "global_settings": {
        "tts": {
            "provider": "local_file",
            "audio_file": "./temp/download.wav"
        },
        "subtitle": {
            "font_path": "./assets/fonts/Montserrat/Montserrat-Black.ttf",
            "font_size": 110,
            "color": "#FFFFFF",
            "uppercase": true,
            "stroke_enabled": false,
            "shadow_enabled": true,
            "shadow_color": "#000000",
            "shadow_opacity": 0.95,
            "blur_radius": 6.0,
            "shadow_offset": [
                4,
                4
            ]
        },
        "background": {
            "visual": {
                "type": "directory",
                "source": "./assets/video/defaults/IA/CEU",
                "fit_mode": "contain-blur",
                "animation": {
                    "type": "zoom",
                    "duration": 20.0,
                    "intensity": 0.12
                }
            },
            "audio": {
                "type": "directory",
                "source": "./assets/audio/background/vidadeoracao",
                "//source": "./assets/audio/background/inspiration"
            }
        },
        "transitions": {
            "enabled": true,
            "audio": {
                "type": "directory",
                "source": "./assets/audio/effects/transitions",
                "volume": 1.0
            }
        }
    },
    "youtube": {
        "token_file_name": "vida_de_oracao.json",
        "privacy_status": "private",
        "category_id": "22"
    }
