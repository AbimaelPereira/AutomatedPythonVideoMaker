{
    "global_settings": {
        "tts/": {
            "provider": "local_file",
            "audio_file": "./temp/geo.wav"
        },
        "tts": {
            "provider": "edge",
            "voice": "pt-BR-AntonioNeural",
            "pitch": "-45Hz",
            "rate": "+0%"
        },
        "subtitle": {
            "font_path": "./assets/fonts/Source Code Pro/SourceCodePro-SemiBold.ttf",
            "font_size": 116,
            "color": "#000000",
            "uppercase": true,
            "stroke_enabled": false,
            "stroke_color": "#59ff00",
            "stroke_width": 3,

            "shadow_enabled": true,
            "shadow_color": "#56f500",
            "shadow_opacity": 1,
            "blur_radius": 8,
            "shadow_offset": [
                0,
                0
            ]
        },
        "background": {
            "audio": {
                "type": "directory",
                "source": "./assets/audio/background/inspiration",
                "ducking": {
                    "enabled": true,
                    "ducking_db": -10.0
                }
            },
            "visual": {
                "fit_mode": "contain-blur",
                "animation": {
                    "type": "zoom",
                    "duration": 20.0,
                    "intensity": 0.12
                }
            }
        },
        "transitions": {
            "enabled": true,
            "audio": {
                "type": "directory",
                "source": "./assets/audio/effects/transitions",
                "volume": 1.0
            }
        }
    },
    "youtube": {
        "token_file_name": "geopolitica_em_foco.json",
        "privacy_status": "private",
        "category_id": "22"
    }
}