# Byte-compiled / optimized / DLL files
__pycache__/

.env

# Ignorar conteúdo, mas manter a pasta no repo
/development/audios_vozes_ptbr/*
/output/*
!/output/.gitkeep

/assets/audio/*
!/assets/audio/.gitkeep

/assets/audio/background/*
!/assets/audio/background/.gitkeep

/assets/audio/effects/*
!/assets/audio/effects/.gitkeep

/assets/fonts/*
!/assets/fonts/.gitkeep

/assets/image/*
!/assets/image/.gitkeep

/assets/temp/*
!/assets/temp/.gitkeep

/assets/video/defaults/*
!/assets/video/defaults/.gitkeep

/jsons/*
!/jsons/.gitkeep

/tokens/*
!/tokens/.gitkeep

/cache/ai_generated/*
!/cache/ai_generated/.gitkeep

# --- Configuração do Whisper ---

# Ignorar o ambiente virtual criado (Isso é o mais importante)
venv-whisper/

# Ignorar caches de compilação do Python (se já não estiver no arquivo)
__pycache__/
libs/Whisper/__pycache__/

# qualquer __pycache__ que possa existir em todo o projeto
**/__pycache__/