# Byte-compiled / optimized / DLL files
__pycache__/

.env

# Ignorar conteúdo, mas manter a pasta no repo
/development/audios_vozes_ptbr/*
/output/*
!/output/.gitkeep

/assets/audio/*
!/assets/audio/.gitkeep

/assets/audio/background/*
!/assets/audio/background/.gitkeep

/assets/audio/effects/*
!/assets/audio/effects/.gitkeep

/assets/fonts/*
!/assets/fonts/.gitkeep

/assets/image/*
!/assets/image/.gitkeep

/assets/temp/*
!/assets/temp/.gitkeep

/assets/video/defaults/*
!/assets/video/defaults/.gitkeep

/jsons/*
!/jsons/.gitkeep

/tokens/*
!/tokens/.gitkeep

/cache/ai_generated/*
!/cache/ai_generated/.gitkeep