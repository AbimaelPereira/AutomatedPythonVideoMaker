# ── Ambiente ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Debug ─────────────────────────────────────────────────────────────────────
# DEBUG=1 → pula upload para YouTube e abre o vídeo localmente
DEBUG=0
DEBUG_LAYOUT=0

# ── Paralelismo ───────────────────────────────────────────────────────────────
# Cai automaticamente para 1 se RAM disponível < 4 GB
MAX_PARALLEL_SCENES=2

# ── Gemini (usado em a.py e reelscutter) ──────────────────────────────────────
GEMINI_API_KEY=

# ── Pollinations (geração de imagens via IA) ──────────────────────────────────
POLLINATIONS_API_TOKEN=

# ── TikTok (opcional) ─────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8085/callback

# ── Google Cloud TTS (opcional — só se usar provider "google") ────────────────
GOOGLE_APPLICATION_CREDENTIALS=tokens/tts-automate-videos-XXXXXXX.json
GOOGLE_TTS_RATE=1.15
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_VOLUME=0.0

# ── AWS Polly (opcional — só se usar provider "polly") ────────────────────────
AWS_REGION=us-east-1
POLLY_VOICE_ID=Camila
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=pt-BR
POLLY_OUTPUT_FORMAT=mp3

# ── YouTube ───────────────────────────────────────────────────────────────────
CLIENT_SECRETS_FILE=tokens/youtube_client_secret.json
TOKEN_DIR=tokens
TOKEN_FILE_NAME=token_default.json
VIDEO_PRIVACY=private
VIDEO_CATEGORY_ID=22
TIMEZONE=America/Sao_Paulo

# ── Reelscutter — mock para testes sem gastar cota do Gemini (opcional) ───────
# REELSCUTTER_MOCK_FILE=/caminho/para/mock_clips.json
